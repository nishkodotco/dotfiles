// VS Code key bindings for all profiles (Default, Xponent, Machine Learning).
// Plan: https://claude.ai/artifact/78SwS4mLggVj61bLgjodG6
// Part 1 adds the scheme.
// Part 2 removes the other VS Code defaults.
// To bring defaults back, delete Part 2.
[
  // ===== Part 1: scheme =====
  // --- VS Code itself ---
  {"key": "cmd+shift+p", "command": "workbench.action.showCommands"},
  {"key": "cmd+shift+s", "command": "workbench.action.openSettingsJson"},
  // {"key": "cmd+shift+k", "command": "workbench.action.openGlobalKeybindingsFile"}, // replaced: Cmd+Shift+K = Open Folder
  {"key": "cmd+shift+k", "command": "workbench.action.files.openFolder"},
  {"key": "cmd+shift+x", "command": "workbench.view.extensions"},
  // {"key": "cmd+shift+o", "command": "workbench.profiles.actions.switchProfile"}, // replaced: Cmd+Shift+O = Open File
  {"key": "cmd+shift+o", "command": "workbench.action.files.openFile"},
  {"key": "cmd+shift+n", "command": "workbench.action.newWindow"},
  {"key": "cmd+shift+r", "command": "workbench.action.reloadWindow"},
  {"key": "cmd+shift+;", "command": "runCommands", "args": {"commands": ["workbench.action.files.saveAll", "workbench.action.reloadWindow"]}},
  // --- Zoom: Cmd+= / Cmd+- / Cmd+0 change the editor font when an editor or notebook has focus, and the terminal font in the terminal. They never zoom the window. ---
  {"key": "cmd+=", "command": "editor.action.fontZoomIn", "when": "editorFocus || notebookEditorFocused"},
  {"key": "cmd+-", "command": "editor.action.fontZoomOut", "when": "editorFocus || notebookEditorFocused"},
  {"key": "cmd+0", "command": "editor.action.fontZoomReset", "when": "editorFocus || notebookEditorFocused"},
  {"key": "cmd+=", "command": "workbench.action.terminal.fontZoomIn", "when": "terminalFocus"},
  {"key": "cmd+-", "command": "workbench.action.terminal.fontZoomOut", "when": "terminalFocus"},
  {"key": "cmd+0", "command": "workbench.action.terminal.fontZoomReset", "when": "terminalFocus"},
  // --- Editor and layout ---
  {"key": "cmd+alt+left", "command": "workbench.action.previousEditor"},
  {"key": "cmd+alt+right", "command": "workbench.action.nextEditor"},
  {"key": "cmd+alt+t", "command": "workbench.action.closeOtherEditors"},
  {"key": "cmd+alt+\\", "command": "workbench.action.splitEditorRight"},
  {"key": "cmd+alt+-", "command": "workbench.action.splitEditorDown"},
  {"key": "cmd+alt+1", "command": "workbench.action.focusFirstEditorGroup"},
  {"key": "cmd+alt+2", "command": "workbench.action.focusSecondEditorGroup"},
  {"key": "cmd+alt+3", "command": "workbench.action.focusThirdEditorGroup"},
  {"key": "cmd+alt+b", "command": "workbench.action.toggleSidebarVisibility"},
  {"key": "cmd+alt+j", "command": "workbench.action.togglePanel"},
  {"key": "cmd+alt+z", "command": "workbench.action.toggleZenMode"},
  // --- File manager ---
  {"key": "ctrl+alt+e", "command": "workbench.view.explorer"},
  {"key": "ctrl+alt+n", "command": "explorer.newFile"},
  {"key": "ctrl+alt+f", "command": "explorer.newFolder"},
  {"key": "ctrl+alt+r", "command": "workbench.files.action.showActiveFileInExplorer"},
  {"key": "ctrl+alt+c", "command": "workbench.files.action.collapseExplorerFolders"},
  // --- In the file: plain Cmd. The same key acts on text in the editor and on the selected file in the Explorer: Cmd+C copy, Cmd+X cut, Cmd+V paste, Cmd+Z undo (kept VS Code defaults), Cmd+F find, Cmd+D delete, Cmd+R rename. Opt / Opt+Shift arrows move lines and add cursors. ---
  {"key": "alt+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "alt+down", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "alt+shift+up", "command": "editor.action.insertCursorAbove", "when": "editorTextFocus"},
  {"key": "alt+shift+down", "command": "editor.action.insertCursorBelow", "when": "editorTextFocus"},
  {"key": "cmd+j", "command": "editor.action.joinLines", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+/", "command": "editor.action.commentLine", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+b", "command": "editor.action.formatDocument", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+n", "command": "editor.action.addSelectionToNextFindMatch", "when": "editorFocus"},
  {"key": "cmd+l", "command": "editor.action.selectHighlights", "when": "editorFocus"},
  // {"key": "cmd+o", "command": "editor.action.sortLinesAscending", "when": "editorTextFocus && !editorReadonly"}, // replaced by Cmd+O = Output below
  {"key": "cmd+[", "command": "editor.fold", "when": "editorTextFocus"},
  {"key": "cmd+]", "command": "editor.unfold", "when": "editorTextFocus"},
  // {"key": "cmd+e", "command": "editor.action.triggerSuggest", "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"}, // replaced by Cmd+E = focus editor below
  // {"key": "cmd+p", "command": "editor.action.triggerParameterHints", "when": "editorTextFocus"}, // replaced by Cmd+P = Ports below; parameter hints stay on Cmd+H
  // {"key": "cmd+h", "command": "editor.action.triggerParameterHints"}, // moved to Cmd+D (macOS "Hide" is on Ctrl+Opt+Cmd+H in NSUserKeyEquivalents)
  {"key": "cmd+d", "command": "runCommands", "when": "editorTextFocus", "args": {"commands": ["editor.action.triggerParameterHints", {"command": "editor.action.showHover", "args": {"focus": "autoFocusImmediately"}}]}}, // docs on a name (focused, so arrows read it) + parameter hints inside brackets
  {"key": "cmd+d", "command": "runCommands", "when": "editorHoverFocused || editorTextFocus && (parameterHintsVisible || editorHoverVisible)", "args": {"commands": ["closeParameterHints", "editor.action.hideHover", "workbench.action.focusActiveEditorGroup"]}}, // press Cmd+D again to close the docs / hints
  // While the docs popup has focus: Up/Down scroll (VS Code default), Left/Right page through it
  {"key": "left", "command": "editor.action.pageUpHover", "when": "editorHoverFocused"},
  {"key": "right", "command": "editor.action.pageDownHover", "when": "editorHoverFocused"},
  // Docs popup open but not focused yet: the first arrow press focuses it and scrolls/pages
  {"key": "down", "command": "runCommands", "when": "editorHoverVisible && !editorHoverFocused && editorTextFocus && !suggestWidgetVisible", "args": {"commands": [{"command": "editor.action.showHover", "args": {"focus": "focusIfVisible"}}, "editor.action.scrollDownHover"]}},
  {"key": "up", "command": "runCommands", "when": "editorHoverVisible && !editorHoverFocused && editorTextFocus && !suggestWidgetVisible", "args": {"commands": [{"command": "editor.action.showHover", "args": {"focus": "focusIfVisible"}}, "editor.action.scrollUpHover"]}},
  {"key": "right", "command": "runCommands", "when": "editorHoverVisible && !editorHoverFocused && editorTextFocus && !suggestWidgetVisible", "args": {"commands": [{"command": "editor.action.showHover", "args": {"focus": "focusIfVisible"}}, "editor.action.pageDownHover"]}},
  {"key": "left", "command": "runCommands", "when": "editorHoverVisible && !editorHoverFocused && editorTextFocus && !suggestWidgetVisible", "args": {"commands": [{"command": "editor.action.showHover", "args": {"focus": "focusIfVisible"}}, "editor.action.pageUpHover"]}},
  // Docs popup focused: Up/Down scroll, Left/Right page
  {"key": "down", "command": "editor.action.scrollDownHover", "when": "editorHoverFocused"},
  {"key": "up", "command": "editor.action.scrollUpHover", "when": "editorHoverFocused"},
  // {"key": "cmd+d", "command": "editor.action.deleteLines", "when": "editorTextFocus && !editorReadonly"}, // disabled: Cmd+D is now docs; Delete Line has no shortcut
  {"key": "cmd+d", "command": "moveFileToTrash", "when": "filesExplorerFocus && !inputFocus"}, // Cmd+D in the Explorer: move to Trash (docs in the editor)
  {"key": "cmd+r", "command": "editor.action.rename", "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"},
  {"key": "cmd+r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus"},
  {"key": "cmd+f", "command": "list.find", "when": "listFocus && listSupportsFind && !inputFocus"},
  // --- With the file: Ctrl+Shift acts on the open file from the editor (R rename, D delete, C copy path). ---
  {"key": "ctrl+shift+r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus"},
  {"key": "ctrl+shift+r", "command": "runCommands", "when": "!filesExplorerFocus", "args": {"commands": ["workbench.files.action.showActiveFileInExplorer", "renameFile"]}},
  {"key": "ctrl+shift+d", "command": "runCommands", "when": "!filesExplorerFocus", "args": {"commands": ["workbench.files.action.showActiveFileInExplorer", "moveFileToTrash"]}},
  {"key": "ctrl+shift+c", "command": "copyRelativeFilePath"},
  {"key": "ctrl+shift+s", "command": "workbench.action.files.saveAs"},
  {"key": "ctrl+shift+o", "command": "revealFileInOS"},
  // --- Find and go to ---
  {"key": "ctrl+p", "command": "workbench.action.quickOpen"},
  // Ctrl+F = Search all files (press again to close)
  {"key": "ctrl+f", "command": "workbench.action.findInFiles"},
  {"key": "ctrl+f", "command": "runCommands", "when": "sideBarVisible && activeViewlet == 'workbench.view.search'", "args": {"commands": ["workbench.action.closeSidebar", "workbench.action.focusActiveEditorGroup"]}},
  // Cmd+F = find in the current file; press again to close (Esc no longer closes it)
  {"key": "cmd+f", "command": "actions.find", "when": "editorFocus"},
  {"key": "cmd+f", "command": "notebook.find", "when": "notebookEditorFocused && !editorFocus || notebookEditorFocused && notebookCellEditorFocused"},
  {"key": "cmd+f", "command": "runCommands", "when": "findWidgetVisible && (editorFocus || findInputFocussed)", "args": {"commands": ["closeFindWidget", "workbench.action.focusActiveEditorGroup"]}},
  {"key": "cmd+f", "command": "runCommands", "when": "notebookEditorFocused && findWidgetVisible || notebookFindWidgetFocused", "args": {"commands": ["notebook.hideFind", "workbench.action.focusActiveEditorGroup"]}},
  {"key": "escape", "command": "-closeFindWidget"},
  {"key": "escape", "command": "-notebook.hideFind"},
  // --- Notebooks, cell mode (Esc out of the cell first): Cmd+A add above, Cmd+B add below, Cmd+D delete cell ---
  {"key": "cmd+a", "command": "notebook.cell.insertCodeCellAboveAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "cmd+b", "command": "notebook.cell.insertCodeCellBelowAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "cmd+d", "command": "notebook.cell.delete", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "a", "command": "-notebook.cell.insertCodeCellAboveAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "b", "command": "-notebook.cell.insertCodeCellBelowAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "d d", "command": "-notebook.cell.delete", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"},
  {"key": "ctrl+h", "command": "workbench.action.replaceInFiles"},
  {"key": "ctrl+o", "command": "workbench.action.gotoSymbol"},
  {"key": "ctrl+t", "command": "workbench.action.showAllSymbols"},
  {"key": "ctrl+l", "command": "workbench.action.gotoLine"},
  {"key": "ctrl+[", "command": "workbench.action.navigateBack"},
  {"key": "ctrl+]", "command": "workbench.action.navigateForward"},
  // --- Code ---
  {"key": "cmd+alt+shift+d", "command": "editor.action.revealDefinition", "when": "editorTextFocus"},
  {"key": "cmd+alt+shift+p", "command": "editor.action.peekDefinition", "when": "editorTextFocus"},
  {"key": "cmd+alt+shift+u", "command": "references-view.findReferences", "when": "editorTextFocus"},
  {"key": "cmd+alt+shift+i", "command": "editor.action.goToImplementation", "when": "editorTextFocus"},
  {"key": "cmd+alt+shift+.", "command": "editor.action.quickFix", "when": "editorTextFocus"},
  {"key": "cmd+alt+shift+o", "command": "editor.action.organizeImports", "when": "editorTextFocus"},
  // --- Run ---
  {"key": "cmd+ctrl+t", "command": "workbench.action.tasks.runTask"},
  {"key": "cmd+ctrl+e", "command": "workbench.action.tasks.reRunTask"},
  {"key": "cmd+ctrl+k", "command": "workbench.action.tasks.terminate"},
  {"key": "cmd+ctrl+`", "command": "workbench.action.terminal.toggleTerminal"},
  {"key": "cmd+ctrl+n", "command": "workbench.action.terminal.new"},
  // --- Panel keys: press once to open, press again to close and go back to the editor ---
  {"key": "cmd+t", "command": "workbench.action.createTerminalEditor"}, // new terminal as an editor tab
  {"key": "cmd+t", "command": "openInIntegratedTerminal", "when": "filesExplorerFocus && !inputFocus"}, // in the Explorer: new terminal tab at the selected file's folder
  {"key": "cmd+o", "command": "workbench.action.output.toggleOutput"},
  {"key": "cmd+o", "command": "runCommands", "when": "panelVisible && activePanel == 'workbench.panel.output'", "args": {"commands": ["workbench.action.closePanel", "workbench.action.focusActiveEditorGroup"]}},
  {"key": "cmd+p", "command": "~remote.forwardedPorts.focus"},
  {"key": "cmd+p", "command": "runCommands", "when": "panelVisible && activePanel == '~remote.forwardedPortsContainer'", "args": {"commands": ["workbench.action.closePanel", "workbench.action.focusActiveEditorGroup"]}},
  {"key": "cmd+e", "command": "workbench.action.focusActiveEditorGroup"},
  {"key": "cmd+e", "command": "workbench.files.action.focusFilesExplorer", "when": "editorFocus || notebookEditorFocused || terminalFocus"},
  // --- Sidebar: direct jumps, and Cmd+Shift+Up/Down to cycle through every sidebar view (incl. extensions) ---
  {"key": "shift+cmd+e", "command": "workbench.view.explorer"},
  {"key": "shift+cmd+e", "command": "runCommands", "when": "sideBarVisible && activeViewlet == 'workbench.view.explorer'", "args": {"commands": ["workbench.action.closeSidebar", "workbench.action.focusActiveEditorGroup"]}}, // press again: close Explorer, back to editor
  {"key": "shift+cmd+f", "command": "workbench.action.findInFiles"},
  {"key": "shift+cmd+f", "command": "runCommands", "when": "sideBarVisible && activeViewlet == 'workbench.view.search'", "args": {"commands": ["workbench.action.closeSidebar", "workbench.action.focusActiveEditorGroup"]}}, // press again: close Search, back to editor
  {"key": "shift+cmd+g", "command": "workbench.view.scm"},
  {"key": "shift+cmd+up", "command": "workbench.action.previousSideBarView"},
  {"key": "shift+cmd+up", "command": "-cursorTopSelect", "when": "textInputFocus"}, // select-to-top freed; give it a new key later
  {"key": "shift+cmd+down", "command": "workbench.action.nextSideBarView"},
  {"key": "shift+cmd+down", "command": "-cursorBottomSelect", "when": "textInputFocus"}, // select-to-bottom freed; give it a new key later
  {"key": "cmd+ctrl+b", "command": "workbench.action.debug.start"},
  // --- Git ---
  {"key": "cmd+ctrl+shift+g", "command": "workbench.view.scm"},
  {"key": "cmd+ctrl+shift+b", "command": "git.checkout"},
  {"key": "cmd+ctrl+shift+c", "command": "git.commit"},
  {"key": "cmd+ctrl+shift+p", "command": "git.push"},
  {"key": "cmd+ctrl+shift+l", "command": "git.pull"},
  {"key": "cmd+ctrl+shift+d", "command": "git.openChange"},
  {"key": "cmd+ctrl+shift+h", "command": "timeline.focus"},
  // --- Xponent ---
  {"key": "cmd+ctrl+alt+l", "command": "workbench.action.tasks.runTask", "args": "⚡ Local: Start everything"},
  {"key": "cmd+ctrl+alt+s", "command": "simpleBrowser.show", "args": "http://localhost:54323"},
  {"key": "cmd+ctrl+alt+a", "command": "simpleBrowser.show", "args": "http://localhost:18888"},
  // --- kept from old file ---
  {"key": "ctrl+alt+o", "command": "workbench.action.files.openFileFolder", "when": "isMacNative && openFolderWorkspaceSupport"}, // kept from old file
  {"key": "cmd+o", "command": "-workbench.action.files.openFileFolder", "when": "isMacNative && openFolderWorkspaceSupport"}, // kept from old file
  {"key": "ctrl+`", "command": "-workbench.action.terminal.toggleTerminal"}, // kept from old file
  {"key": "ctrl+`", "command": "workbench.action.createTerminalEditor"}, // kept from old file
  // ===== Part 2: remove other VS Code 1.144.0 macOS defaults (631 entries) =====
  {"key": "ctrl+n", "command": "-cursorDown", "when": "textInputFocus"},
  {"key": "ctrl+b", "command": "-cursorLeft", "when": "textInputFocus"},
  {"key": "ctrl+e", "command": "-cursorLineEnd", "when": "textInputFocus"},
  {"key": "ctrl+shift+e", "command": "-cursorLineEndSelect", "when": "textInputFocus"},
  {"key": "ctrl+a", "command": "-cursorLineStart", "when": "textInputFocus"},
  {"key": "ctrl+shift+a", "command": "-cursorLineStartSelect", "when": "textInputFocus"},
  {"key": "ctrl+f", "command": "-cursorRight", "when": "textInputFocus"},
  {"key": "ctrl+p", "command": "-cursorUp", "when": "textInputFocus"},
  {"key": "ctrl+h", "command": "-deleteLeft", "when": "textInputFocus"},
  {"key": "ctrl+d", "command": "-deleteRight", "when": "textInputFocus"},
  {"key": "cmd+l", "command": "-expandLineSelection", "when": "textInputFocus"},
  {"key": "ctrl+o", "command": "-lineBreakInsert", "when": "textInputFocus && !editorReadonly"},
  {"key": "cmd+k cmd+i", "command": "-workbench.action.showHover"},
  {"key": "f12", "command": "-goToNextReference", "when": "inReferenceSearchEditor || referenceSearchVisible"},
  {"key": "f4", "command": "-goToNextReference", "when": "inReferenceSearchEditor || referenceSearchVisible"},
  {"key": "shift+f12", "command": "-goToPreviousReference", "when": "inReferenceSearchEditor || referenceSearchVisible"},
  {"key": "shift+f4", "command": "-goToPreviousReference", "when": "inReferenceSearchEditor || referenceSearchVisible"},
  {"key": "cmd+e", "command": "-actions.findWithSelection"},
  {"key": "cmd+u", "command": "-cursorUndo", "when": "textInputFocus"},
  {"key": "ctrl+k", "command": "-deleteAllRight", "when": "textInputFocus && !editorReadonly"},
  {"key": "f7", "command": "-editor.action.accessibleDiffViewer.next", "when": "isInDiffEditor"},
  {"key": "shift+f7", "command": "-editor.action.accessibleDiffViewer.prev", "when": "isInDiffEditor"},
  {"key": "cmd+k cmd+c", "command": "-editor.action.addCommentLine", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+d", "command": "-editor.action.addSelectionToNextFindMatch", "when": "editorFocus"},
  {"key": "alt+cmd+.", "command": "-editor.action.autoFix", "when": "textInputFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)quickfix\\b/"},
  {"key": "shift+alt+a", "command": "-editor.action.blockComment", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+f2", "command": "-editor.action.changeAll", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+/", "command": "-editor.action.commentLine", "when": "editorTextFocus && !editorReadonly"},
  {"key": "shift+alt+down", "command": "-editor.action.copyLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "shift+alt+up", "command": "-editor.action.copyLinesUpAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "shift+cmd+k", "command": "-editor.action.deleteLines", "when": "textInputFocus && !editorReadonly"},
  {"key": "alt+f3", "command": "-editor.action.dirtydiff.next", "when": "editorTextFocus && !textCompareEditorActive"},
  {"key": "shift+alt+f3", "command": "-editor.action.dirtydiff.previous", "when": "editorTextFocus && !textCompareEditorActive"},
  {"key": "shift+alt+f", "command": "-editor.action.formatDocument", "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"},
  {"key": "shift+alt+f", "command": "-editor.action.formatDocument.none", "when": "editorTextFocus && !editorHasDocumentFormattingProvider && !editorReadonly"},
  {"key": "cmd+k cmd+f", "command": "-editor.action.formatSelection", "when": "editorHasDocumentSelectionFormattingProvider && editorTextFocus && !editorReadonly"},
  {"key": "cmd+f12", "command": "-editor.action.goToImplementation", "when": "editorHasImplementationProvider && editorTextFocus"},
  {"key": "shift+f12", "command": "-editor.action.goToReferences", "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
  {"key": "shift+cmd+.", "command": "-editor.action.inPlaceReplace.down", "when": "editorTextFocus && !editorReadonly"},
  {"key": "shift+cmd+,", "command": "-editor.action.inPlaceReplace.up", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+]", "command": "-editor.action.indentLines", "when": "editorTextFocus && !editorReadonly"},
  {"key": "alt+]", "command": "-editor.action.inlineSuggest.showNext", "when": "inlineSuggestionVisible && !editorReadonly"},
  {"key": "alt+[", "command": "-editor.action.inlineSuggest.showPrevious", "when": "inlineSuggestionVisible && !editorReadonly"},
  {"key": "shift+alt+i", "command": "-editor.action.insertCursorAtEndOfEachLineSelected", "when": "editorTextFocus"},
  {"key": "ctrl+j", "command": "-editor.action.joinLines", "when": "editorTextFocus && !editorReadonly"},
  {"key": "shift+cmd+\\", "command": "-editor.action.jumpToBracket", "when": "editorTextFocus"},
  {"key": "shift+cmd+f2", "command": "-editor.action.linkedEditing", "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"},
  {"key": "alt+f8", "command": "-editor.action.marker.next", "when": "editorFocus"},
  {"key": "f8", "command": "-editor.action.marker.nextInFiles", "when": "editorFocus"},
  {"key": "shift+alt+f8", "command": "-editor.action.marker.prev", "when": "editorFocus"},
  {"key": "shift+f8", "command": "-editor.action.marker.prevInFiles", "when": "editorFocus"},
  {"key": "alt+down", "command": "-editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "alt+up", "command": "-editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly"},
  {"key": "cmd+k cmd+d", "command": "-editor.action.moveSelectionToNextFindMatch", "when": "editorFocus"},
  {"key": "alt+f9", "command": "-editor.action.nextCommentThreadAction"},
  {"key": "alt+f10", "command": "-editor.action.nextCommentedRangeAction", "when": "activeEditorHasCommentingRange"},
  {"key": "cmd+k alt+cmd+down", "command": "-editor.action.nextCommentingRange", "when": "accessibilityModeEnabled && commentFocused || accessibilityModeEnabled && editorFocus || accessibilityHelpIsShown && accessibilityModeEnabled && accessibleViewCurrentProviderId == 'comments'"},
  {"key": "f3", "command": "-editor.action.nextMatchFindAction", "when": "editorFocus"},
  {"key": "cmd+g", "command": "-editor.action.nextMatchFindAction", "when": "editorFocus"},
  {"key": "cmd+f3", "command": "-editor.action.nextSelectionMatchFindAction", "when": "editorFocus"},
  {"key": "shift+alt+o", "command": "-editor.action.organizeImports", "when": "textInputFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/"},
  {"key": "cmd+[", "command": "-editor.action.outdentLines", "when": "editorTextFocus && !editorReadonly"},
  {"key": "alt+down", "command": "-editor.action.pageDownHover", "when": "editorHoverFocused"},
  {"key": "alt+up", "command": "-editor.action.pageUpHover", "when": "editorHoverFocused"},
  {"key": "alt+f12", "command": "-editor.action.peekDefinition", "when": "editorHasDefinitionProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
  {"key": "shift+cmd+f12", "command": "-editor.action.peekImplementation", "when": "editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"},
  {"key": "shift+alt+f9", "command": "-editor.action.previousCommentThreadAction"},
  {"key": "shift+alt+f10", "command": "-editor.action.previousCommentedRangeAction", "when": "activeEditorHasCommentingRange"},
  {"key": "cmd+k alt+cmd+up", "command": "-editor.action.previousCommentingRange", "when": "accessibilityModeEnabled && commentFocused || accessibilityModeEnabled && editorFocus || accessibilityHelpIsShown && accessibilityModeEnabled && accessibleViewCurrentProviderId == 'comments'"},
  {"key": "shift+f3", "command": "-editor.action.previousMatchFindAction", "when": "editorFocus"},
  {"key": "shift+cmd+g", "command": "-editor.action.previousMatchFindAction", "when": "editorFocus"},
  {"key": "shift+cmd+f3", "command": "-editor.action.previousSelectionMatchFindAction", "when": "editorFocus"},
  {"key": "cmd+.", "command": "-editor.action.quickFix", "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly"},
